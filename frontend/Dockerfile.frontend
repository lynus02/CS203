# Dockerfile (React frontend)
# --- Build Stage ---
FROM node:18-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# --- Runtime Stage ---
FROM nginx:alpine

# Copy build output to Nginx's static folder
COPY --from=build /app/build /usr/share/nginx/html

# Optional: custom nginx config if you’re using React Router
COPY nginx.conf /etc/nginx/nginx.conf

# Expose the port that Nginx serves on
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]